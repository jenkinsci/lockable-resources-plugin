<?jelly escape-by-default='true'?>
<!--
  Edit/add resource dialog template and JavaScript translations.
  Shared by the main page (_content.jelly) and the resource detail page
  (LockableResource/index.jelly), so both use the same form.

  Expects 'it' to be the LockableResourcesRootAction instance.
 -->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
      <!-- Add Resource dialog content (rendered via dialog.modal on click) -->
      <l:hasPermission permission="${it.CONFIGURE}">
        <template id="lr-add-resource-template">
          <div class="app-parameters-dialog">
            <div class="jenkins-form-item">
              <label class="jenkins-form-label">${%add.resource.dialog.name} <span class="jenkins-!-error-color">*</span></label>
              <input type="text" name="name" class="jenkins-input" required="required" />
            </div>
            <div class="jenkins-form-item">
              <label class="jenkins-form-label">${%add.resource.dialog.description}</label>
              <input type="text" name="description" class="jenkins-input" />
            </div>
            <div class="jenkins-form-item">
              <label class="jenkins-form-label">${%add.resource.dialog.labels}</label>
              <input type="text" name="labels" class="jenkins-input" placeholder="label1 label2" />
            </div>
            <div class="jenkins-form-item">
              <label class="jenkins-form-label">${%add.resource.dialog.group}</label>
              <input type="text" name="group" class="jenkins-input" value="common" />
              <div class="jenkins-!-color-secondary">${%add.resource.dialog.groupHint}</div>
            </div>
            <div class="jenkins-form-item">
              <label class="jenkins-form-label">${%add.resource.dialog.properties}</label>
              <div class="lr-properties-container">
                <!-- dynamic property rows inserted here by JS -->
              </div>
              <button type="button" class="jenkins-button jenkins-!-margin-top-1 lr-add-property-btn">
                + ${%add.resource.dialog.addProperty}
              </button>
            </div>
          </div>
        </template>
      </l:hasPermission>

      <!-- translations for javascript -->
      <template id="i18n"
                  data-queue-title="${%queue.change.title}"
                  data-queue-message="${%queue.change.message}"
                  data-queue-on-success="${%queue.change.on.success}"
                  data-queue-on-fail="${%queue.change.on.fail}"
                  data-resource-editor-property-name-placeholder="${%resource.editor.property.name.placeholder}"
                  data-resource-editor-property-value-placeholder="${%resource.editor.property.value.placeholder}"
                  data-resource-editor-property-remove-label="${%resource.editor.property.remove.label}"
                  data-resource-editor-loading="${%resource.editor.loading}"
                  data-resource-editor-label-prefix="${%resource.editor.label.prefix}"
                  data-resource-editor-select-all="${%resource.editor.selectAll}"
                  data-resource-editor-select-one="${%resource.editor.selectOne}"
                  data-resource-editor-page-size-all="${%resource.editor.pageSizeAll}"
                  data-resource-editor-colvis-all="${%resource.editor.colvis.all}"
                  data-resource-editor-colvis-none="${%resource.editor.colvis.none}"
                  data-resource-editor-label-expression-filter-error="${%resource.editor.labelExpressionFilter.error}"
                  data-resource-editor-queue-loading="${%resource.editor.queue.loading}"
                  data-resource-editor-table-column-index="${%resource.editor.table.column.index}"
                  data-resource-editor-table-column-resource="${%resource.editor.table.column.resource}"
                  data-resource-editor-table-column-status="${%resource.editor.table.column.status}"
                  data-resource-editor-table-column-held-by="${%resource.editor.table.column.heldBy}"
                  data-resource-editor-table-column-reason="${%resource.editor.table.column.reason}"
                  data-resource-editor-table-column-since="${%resource.editor.table.column.since}"
                  data-resource-editor-table-column-labels="${%resource.editor.table.column.labels}"
                  data-resource-editor-table-column-properties="${%resource.editor.table.column.properties}"
                  data-resource-editor-table-column-actions="${%resource.editor.table.column.actions}"
                  data-resource-editor-labels-table-column-labels="${%resource.editor.labels.table.column.labels}"
                  data-resource-editor-labels-table-column-assigned="${%resource.editor.labels.table.column.assigned}"
                  data-resource-editor-labels-table-column-free="${%resource.editor.labels.table.column.free}"
                  data-resource-editor-labels-table-column-percentage="${%resource.editor.labels.table.column.percentage}"
                  data-resource-editor-queue-table-column-position="${%resource.editor.queue.table.column.position}"
                  data-resource-editor-queue-table-column-action="${%resource.editor.queue.table.column.action}"
                  data-resource-editor-queue-table-column-type="${%resource.editor.queue.table.column.type}"
                  data-resource-editor-queue-table-column-request="${%resource.editor.queue.table.column.request}"
                  data-resource-editor-queue-table-column-reason="${%resource.editor.queue.table.column.reason}"
                  data-resource-editor-queue-table-column-requested-by="${%resource.editor.queue.table.column.requestedBy}"
                  data-resource-editor-queue-table-column-requested-at="${%resource.editor.queue.table.column.requestedAt}"
                  data-resource-editor-queue-table-column-priority="${%resource.editor.queue.table.column.priority}"
                  data-resource-editor-queue-table-column-queue-id="${%resource.editor.queue.table.column.queueId}"
                  data-reserve-title="${%reserve.dialog.title}"
                  data-reserve-message="${%reserve.dialog.message}"
                  data-steal-title="${%steal.dialog.title}"
                  data-steal-message="${%steal.dialog.message}"
                  data-disable-title="${%disable.dialog.title}"
                  data-disable-message="${%disable.dialog.message}"
                  data-reassign-title="${%reassign.dialog.title}"
                  data-reassign-message="${%reassign.dialog.message}"
                  data-action-on-success="${%action.on.success}"
                  data-action-on-fail="${%action.on.fail}"
                  data-bulk-result="${%bulk.result}"
                  data-add-resource-on-success="${%add.resource.on.success}"
                  data-add-resource-on-fail="${%add.resource.on.fail}"
                  data-add-resource-name-required="${%add.resource.name.required}"
                  data-add-resource-dialog-title="${%add.resource.dialog.title}"
                  data-btn-addResource="${%btn.addResource}"
                  data-delete-resource-title="${%delete.resource.dialog.title}"
                  data-delete-resource-message="${%delete.resource.dialog.message}"
                  data-delete-resource-on-success="${%delete.resource.on.success}"
                  data-delete-resource-on-fail="${%delete.resource.on.fail}"
                  data-edit-resource-dialog-title="${%edit.resource.dialog.title}"
                  data-edit-resource-btn-save="${%edit.resource.btn.save}"
                  data-edit-resource-on-success="${%edit.resource.on.success}"
                  data-edit-resource-on-fail="${%edit.resource.on.fail}"
      />
</j:jelly>
